/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Astro content-hashes everything under /_astro/, so a changed file gets a new
# URL and this can never serve stale bytes. The previous rule pointed at
# /assets/*, which stopped existing at the Astro migration — so hashed assets
# were revalidating every four hours for no reason.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
