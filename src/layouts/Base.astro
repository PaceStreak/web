---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import agentUrl from "../scripts/agent.js?url";
// Preloaded so the first paint already uses Archivo: text drawn in the
// fallback and then re-wrapped when the font arrived was a layout shift.
import archivoUrl from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: unknown;
}

const { title, description, path, noindex = false, jsonLd } = Astro.props;
// The home page ends with its own, richer call to action; legal pages and the
// 404 are not places to sell.
const showCta = !["/", "/404", "/privacy", "/terms", "/changelog"].includes(path);
---

<!doctype html>
<html lang="en" class="scheme-dark">
  <head>
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} path={path} noindex={noindex} />
    {
      /* JSON-LD is an `application/ld+json` DATA block, not executable script.
         `script-src 'self'` does not apply to it, so this is safe under our
         CSP — unlike an inline behavioural script, which would be blocked
         silently. check-html.py knows the difference and excludes it. */
    }
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body class="min-h-screen">
    <a class="skip" href="#main">Skip to content</a>
    <Nav path={path} />
    <main id="main">
      <slot />
    </main>
    {showCta && <CtaBand />}
    <Footer />
    <script is:inline type="module" src={agentUrl}></script>
  </body>
</html>
