---
import Base from "../layouts/Base.astro";
import { featureGroups, disciplines } from "../data/product";
---

<Base
  title="Features — PaceStreak"
  description="Everything PaceStreak does: ten-second logging, week-based streaks that respect rest, records, XP that never rewards load, private-by-default social, offline sync and full data export."
  path="/features"
>
  <section class="py-16 sm:py-20">
    <div class="wrap">
      <h1
        class="mt-3 max-w-3xl text-[clamp(2.4rem,6vw,3.75rem)] font-semibold leading-[1.02] tracking-tight text-balance"
      >
        Everything it does, and why it does it that way.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted text-pretty">
        This page describes the software as it is today, feature by feature, and
        nothing it doesn't do.
      </p>

      <nav class="mt-10" aria-label="Feature sections">
        <ul class="flex flex-wrap gap-2">
          {
            featureGroups.map((group) => (
              <li>
                <a class="chip" href={`#${group.id}`}>
                  {group.kicker}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    featureGroups.map((group, index) => (
      <section
        id={group.id}
        class:list={[
          "scroll-mt-24 py-16 sm:py-20",
          index % 2 === 0 && "border-y border-line bg-bg-alt",
        ]}
      >
        <div class="wrap grid gap-10 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16">
          <div class="lg:sticky lg:top-24 lg:self-start">
            <p class="font-mono text-sm font-semibold text-accent">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
              {group.title}
            </h2>
            <p class="mt-4 text-[0.98rem] leading-relaxed text-muted">{group.lede}</p>
            {group.id === "streaks" && (
              <a class="btn btn--ghost btn--sm mt-6" href="/streaks">
                How streaks work
              </a>
            )}
            {group.id === "social" && (
              <a class="btn btn--ghost btn--sm mt-6" href="/social">
                The privacy rules
              </a>
            )}
            {group.id === "security" && (
              <a class="btn btn--ghost btn--sm mt-6" href="/security">
                Security in detail
              </a>
            )}
          </div>

          <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
            {group.items.map((item) => (
              <div class="border-t border-line pt-5">
                <dt class="font-semibold">{item.title}</dt>
                <dd class="mt-2 text-[0.96rem] leading-relaxed text-muted">{item.body}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    ))
  }

  <section class="py-16 sm:py-20">
    <div class="wrap">
      <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">
        Anything you can repeat.
      </h2>
      <ul class="mt-8 flex flex-wrap gap-2">
        {disciplines.map((d) => <li class="chip chip--static">{d}</li>)}
      </ul>
    </div>
  </section>

  <section class="pb-8">
    <div class="wrap">
      <div class="card flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">Ready to start?</h2>
          <p class="mt-2 max-w-xl text-[0.96rem] text-muted">
            Create an account and the first week is already waiting for you.
          </p>
        </div>
        <a class="btn shrink-0" href="https://app.pacestreak.com/signup">Get started</a>
      </div>
    </div>
  </section>
</Base>
