---
import WeekBoard from "../components/WeekBoard.astro";
import Base from "../layouts/Base.astro";
import ActivityGrid from "../components/ActivityGrid.astro";
import Faq from "../components/Faq.astro";
import { featuredFaqs } from "../data/faq";
import { facts } from "../data/product";
import appUrl from "../scripts/app.js?url";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "PaceStreak",
  url: "https://www.pacestreak.com",
  logo: "https://www.pacestreak.com/brand/logo.svg",
  email: "hello@pacestreak.com",
  description:
    "A habit and streak tracker. Build the habits you want - training, learning, health, calm - keep each one weekly, and watch the grid fill.",
  sameAs: [
    "https://github.com/PaceStreak",
    "https://x.com/PaceStreak",
    "https://www.instagram.com/pacestreak/",
  ],
};

const steps = [
  {
    n: "1",
    title: "Pick what matters",
    body:
      "Reading, a language, guitar, water, sleep, a workout, or something you're giving up. Start from one of " +
      facts.habitTemplates +
      " ready-made habits or make your own.",
  },
  {
    n: "2",
    title: "Keep the week",
    body: "Each habit gets its own target: three days a week, five, every day. Hit it and the week is kept. Days off cost nothing, and a bad week can be covered by a freeze you earned.",
  },
  {
    n: "3",
    title: "Watch the grid fill",
    body: "Six months of squares is a harder thing to abandon than a to-do list. The grid is the receipt, and it's the reason you go on a Tuesday in February.",
  },
];

const stats = [
  { n: String(facts.habitTemplates), label: "ready-made habits" },
  { n: String(facts.exercises), label: "built-in exercises" },
  { n: String(facts.achievementRules), label: "achievements" },
  { n: "0", label: "ads, trackers or AI vendors" },
];

const oneApp = [
  { usually: "A habit tracker", here: "Weekly streaks per habit, routines, quit habits, a focus timer, import from Loop." },
  { usually: "A workout log", here: `${facts.exercises} exercises, sets and RPE, race plans, blocks, records.` },
  { usually: "A calorie counter", here: "Meals, macros, recipes, barcode lookup and your real energy burn." },
  { usually: "A mood journal", here: "A daily mood, a line about the day, a year in pixels." },
  { usually: "An AI coach", here: "Insights and a daily coach from your own numbers, checked by statistics, not invented." },
];

const habitChips = ["Read 20 pages", "Drink water", "Spanish", "Meditate", "Run", "No smoking"];

const nots = [
  "No rewards for doing more: more hours, more weight, every single day.",
  "Nobody ever sees which habits you keep, or which you're breaking.",
  "No leaderboard for body weight, calories or volume.",
  "No streak lost to a planned rest day.",
  "No analytics, ads, trackers or third-party scripts.",
  "No AI company ever reads what you log.",
  "No lock-in. Export everything, any time.",
];
---

<Base
  title="PaceStreak - Don't break the chain"
  description="PaceStreak is a habit and streak tracker for training, learning, health and everything else worth doing regularly. Keep each habit weekly, watch the grid fill. Rest days never break it."
  path="/"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <a class="badge" href="https://app.pacestreak.com/signup">
          PaceStreak is live
          <svg class="badge-go" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <h1 class="hero-title">
          Don't break<br />the <span class="text-accent">chain</span><em>.</em>
        </h1>

        <p class="hero-lede">
          Motivation is unreliable. Streaks aren't. PaceStreak makes consistency
          the number you chase, for anything worth doing regularly: training,
          learning a skill, sleep, reading, calm, or a habit you're breaking.
        </p>

        <div class="hero-cta">
          <a class="btn btn--lg" href="https://app.pacestreak.com/signup">Get started free</a>
          <a class="btn btn--ghost btn--lg" href="/features">See the features</a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="appwin">
          <div class="appwin-bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <b>app.pacestreak.com</b>
          </div>
          <div class="appwin-body">
            <div class="appwin-stats">
              <p>
                <small>Current streak</small>
                <b class="text-flame">14 <span>weeks</span></b>
              </p>
              <p>
                <small>This week</small>
                <b>2 <span>of 4 today</span></b>
              </p>
              <p class="appwin-stat--lg">
                <small>Longest</small>
                <b>22 <span>weeks</span></b>
              </p>
            </div>
            <WeekBoard />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Numbers -->
  <section class="section--tight statband-wrap" aria-label="PaceStreak in numbers">
    <div class="wrap">
      <ul class="statband">
        {
          stats.map((s) => (
            <li>
              <b>{s.n}</b>
              <span>{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The grid -->
  <section class="section">
    <div class="wrap split">
      <div class="split-copy" data-reveal>
        <h2 class="h2">Six months of squares is hard to walk away from.</h2>
        <p class="lede">
          Every day you show up fills a square. Rest days sit inside a kept week
          without breaking it, so the grid reads like a life, not a perfect
          record. It's the reason you go on a Tuesday in February.
        </p>
        <ul class="mt-6 space-y-2.5 text-[0.98rem]">
          <li class="tick">A year grid, kept weeks and personal records.</li>
          <li class="tick">Planned rest shows as a plan, not a gap.</li>
          <li class="tick">A consistency score that survives a broken streak.</li>
        </ul>
        <a class="btn btn--ghost mt-8" href="/features#progress">How progress works</a>
      </div>
      <div class="split-visual" data-reveal><ActivityGrid /></div>
    </div>
  </section>

  <!-- Features bento -->
  <section id="features" class="section section--alt scroll-mt-24">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <h2 class="h2">Built for people who show up.</h2>
        <p class="lede">
          One place for training and for everything else worth doing regularly,
          with rules that reward turning up and forgive a bad week.
        </p>
      </header>

      <div class="bento">
        <a class="tile tile--a" href="/features#habits" data-reveal>
          <span class="tile-kicker">Habits</span>
          <h3>Anything worth doing regularly</h3>
          <p>
            Tick it, count it or time it: pages, glasses, minutes of practice.
            Set a long goal for a skill and get a date at your current pace.
            Break a habit with clean days, where a slip is logged, not punished.
          </p>
          <ul class="chips" aria-hidden="true">
            {habitChips.map((c) => <li class="chip chip--static">{c}</li>)}
          </ul>
        </a>

        <a class="tile tile--b" href="/features#logging" data-reveal>
          <span class="tile-kicker">Training</span>
          <h3>One tap, or every set</h3>
          <p>
            Quick log for any of {facts.disciplines} disciplines. Sets, reps,
            load and RPE against {facts.exercises} built-in exercises, plus race
            plans and training blocks when you want them.
          </p>
        </a>

        <a class="tile tile--c" href="/streaks" data-reveal>
          <span class="tile-kicker">Streaks</span>
          <h3>Weeks, not days</h3>
          <p>
            Kept weeks against your own target. Earned freezes, one repair a
            month, and an open week that never breaks anything.
          </p>
          <div class="pips" aria-hidden="true">
            <i class="pip pip--on"></i><i class="pip pip--on"></i><i class="pip"></i>
            <i class="pip pip--on"></i><i class="pip pip--on"></i><i class="pip"></i>
            <i class="pip pip--frozen"></i>
          </div>
        </a>

        <a class="tile tile--d" href="/features#progress" data-reveal>
          <span class="tile-kicker">Progress</span>
          <h3>You against you</h3>
          <p>
            A year grid, personal records against your own history, exercise
            trends and a consistency score capped at your plan.
          </p>
        </a>

        <a class="tile tile--e" href="/features#game" data-reveal>
          <span class="tile-kicker">XP and badges</span>
          <h3>Rewards for turning up</h3>
          <p>
            XP, levels, weekly quests and {facts.achievementRules} achievements
            that reward showing up, never doing more.
          </p>
        </a>

        <a class="tile tile--f" href="/social" data-reveal>
          <span class="tile-kicker">Social</span>
          <h3>Crews, not comparisons</h3>
          <p>
            Follows with approval, a feed, kudos, groups, attendance challenges
            and opt-in leaderboards. Your habits stay private: no board ever
            shows which habit, or how much.
          </p>
        </a>

        <a class="tile tile--g" href="/features#anywhere" data-reveal>
          <span class="tile-kicker">Offline</span>
          <h3>Works in a basement</h3>
          <p>
            Logs save on your phone first and sync when you're back above
            ground. Installs to your home screen. Full export in JSON, CSV and
            calendar format.
          </p>
        </a>
      </div>

      <p class="mt-10 text-center">
        <a class="btn btn--ghost" href="/features">Every feature</a>
      </p>
    </div>
  </section>

  <!-- Insights showcase -->
  <section id="insights" class="section scroll-mt-24">
    <div class="wrap split">
      <div class="split-copy" data-reveal>
        <span class="tile-kicker">New</span>
        <h2 class="h2">Feedback from your own numbers. No AI required.</h2>
        <p class="lede">
          PaceStreak compares your days, sleep against habits kept, training
          against mood, food against both, and tells you what actually
          moves. A pattern only shows when a statistical test says it isn't
          chance, and nothing you log is ever sent to an AI company.
        </p>
        <ul class="mt-6 space-y-2.5 text-[0.98rem]">
          <li class="tick">Insights across habits, sleep, mood, training and food.</li>
          <li class="tick">Your real energy burn, from your food log and the scale.</li>
          <li class="tick">A daily coach note, built by rules you can read.</li>
        </ul>
        <a class="btn btn--ghost mt-8" href="/features#insights">How insights work</a>
      </div>
      <div class="split-visual" data-reveal>
        <div class="appwin">
          <div class="appwin-bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <b>app.pacestreak.com/insights</b>
          </div>
          <div class="appwin-body">
            <figure class="insight-mock">
              <figcaption>You kept <b>92%</b> of your habits after 7 h+ of sleep, against <b>42%</b> on shorter nights.</figcaption>
              <div class="insight-bars" aria-hidden="true">
                <span class="insight-bar insight-bar--hi"><i></i>7 h+</span>
                <span class="insight-bar insight-bar--lo"><i></i>Less</span>
              </div>
              <small>Compared 20 days with 20. Example figures.</small>
            </figure>
            <div class="appwin-stats">
              <p>
                <small>Energy burn</small>
                <b>2,550 <span>kcal/day</span></b>
              </p>
              <p>
                <small>Trend</small>
                <b>-0.5 <span>kg/week</span></b>
              </p>
              <p class="appwin-stat--lg">
                <small>Mood this week</small>
                <b>4.2 <span>/ 5</span></b>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- One app -->
  <section class="section section--alt">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <h2 class="h2">One app instead of five.</h2>
        <p class="lede">
          Most people keep consistent with a stack of apps that don't talk to
          each other. PaceStreak puts them on one grid, so the patterns
          between them finally show.
        </p>
      </header>
      <dl class="oneapp" data-reveal>
        {
          oneApp.map((row) => (
            <div class="oneapp-row">
              <dt>
                <span class="oneapp-was">Instead of</span>
                <span>{row.usually}</span>
              </dt>
              <dd>{row.here}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="section scroll-mt-24">
    <div class="wrap">
      <header class="sec-head" data-reveal>
        <h2 class="h2">Three taps. That's the whole ritual.</h2>
      </header>

      <ol class="steps">
        {
          steps.map((step) => (
            <li class="step" data-reveal>
              <span class="step-n" aria-hidden="true">{step.n}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The rule -->
  <section class="section section--alt">
    <div class="wrap split split--top">
      <div class="split-copy" data-reveal>
        <h2 class="h2">Days off are part of it. The streak knows.</h2>
        <p class="lede">
          A daily streak turns a day off into a failure: people train sore, or
          quit the habit the first time life gets in the way. PaceStreak counts
          weeks. With a target of four, three days off cost nothing.
        </p>
        <a class="btn mt-8" href="/streaks">Try the streak simulator</a>
      </div>

      <div class="card card--lg" data-reveal>
        <h3 class="text-lg font-semibold">What PaceStreak will never do</h3>
        <ul class="mt-5 space-y-3.5">
          {nots.map((n) => <li class="cross text-[0.98rem] text-muted">{n}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Build in public -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="card card--lg band" data-reveal>
        <div>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">
            Watch it get built, mistakes included.
          </h2>
          <p class="mt-3 max-w-2xl text-[0.98rem] text-muted">
            How every part of PaceStreak was built and why: the streak engine,
            offline sync, auth, the social privacy rules, and the failures that
            only showed up in production.
          </p>
        </div>
        <a class="btn btn--ghost shrink-0" href="https://blog.pacestreak.com" rel="noopener">
          Read the blog
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="wrap">
      <Faq items={featuredFaqs} />
      <p class="mt-8 text-center text-[0.94rem] text-muted lg:text-left">
        <a class="text-accent underline underline-offset-4" href="/faq">
          All questions
        </a>
      </p>
    </div>
  </section>

  <!-- Get started -->
  <section id="get-started" class="section scroll-mt-24">
    <div class="wrap">
      <div class="cta-band" data-reveal>
        <h2 class="h2">Start your first streak.</h2>
        <p class="lede">
          PaceStreak is live. Create an account and the first week is already
          waiting for you.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="btn btn--lg" href="https://app.pacestreak.com/signup">Get started free</a>
          <a class="btn btn--ghost btn--lg" href="/faq">Read the FAQ</a>
        </div>
        <p class="mt-6 text-[0.94rem] text-muted">
          Already have an account? <a
            class="text-accent underline underline-offset-4"
            href="https://app.pacestreak.com/login">Sign in</a
          >
        </p>
        <p class="mt-2 text-[0.88rem] text-dim">
          No credit card. No tracking beyond what you log yourself.
        </p>
      </div>
    </div>
  </section>

  <script is:inline type="module" src={appUrl}></script>
</Base>
