---
import CalendarPage from "../components/CalendarPage.astro";
import WeekBoard from "../components/WeekBoard.astro";
import Base from "../layouts/Base.astro";
import ActivityGrid from "../components/ActivityGrid.astro";
import Faq from "../components/Faq.astro";
import { featuredFaqs } from "../data/faq";
import { facts } from "../data/product";
import appUrl from "../scripts/app.js?url";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "PaceStreak",
  url: "https://www.pacestreak.com",
  logo: "https://www.pacestreak.com/brand/logo.svg",
  email: "hello@pacestreak.com",
  description:
    "A habit and streak tracker. Build the habits you want - training, learning, health, calm - keep each one weekly, and watch the grid fill.",
  sameAs: [
    "https://github.com/PaceStreak",
    "https://x.com/PaceStreak",
    "https://www.instagram.com/pacestreak/",
  ],
};

const steps = [
  {
    n: "01",
    title: "Pick what matters",
    body: "Reading, a language, guitar, water, sleep, meditation, calling home, a workout, or something you're giving up. Start from one of " + facts.habitTemplates + " ready-made habits or make your own.",
  },
  {
    n: "02",
    title: "Keep the week",
    body: "Each habit gets its own target: three days a week, five, every day. Hit it and the week is kept. Days off cost nothing, and a bad week can be covered by a freeze you earned.",
  },
  {
    n: "03",
    title: "Watch the grid fill",
    body: "Six months of squares is a harder thing to abandon than a to-do list. The grid is the receipt, and it's the reason you go on a Tuesday in February.",
  },
];

const highlights = [
  {
    href: "/features#habits",
    kicker: "Habits",
    title: "Anything worth doing regularly",
    body: "Tick it, count it or time it: pages, glasses, minutes of practice. A long goal for a skill, with a date at your current pace. Break a habit with clean days, where a slip is logged, not punished.",
  },
  {
    href: "/features#logging",
    kicker: "Training",
    title: "One tap, or every set",
    body: "Quick log for any of 11 disciplines. Sets, reps, load and RPE against 78 built-in exercises, race plans and training blocks when you want them.",
  },
  {
    href: "/streaks",
    kicker: "Streaks",
    title: "Weeks, not days",
    body: "Kept weeks against your own target. Earned freezes, one repair a month, and an open week that never breaks anything.",
  },
  {
    href: "/features#progress",
    kicker: "Progress",
    title: "You against you",
    body: "A year grid, personal records against your own history, exercise trends and a consistency score capped at your plan.",
  },
  {
    href: "/features#game",
    kicker: "XP and badges",
    title: "Rewards for turning up",
    body: `XP, levels, weekly quests and ${facts.achievementRules} achievements that reward showing up, never doing more. Habits earn too, with caps so nobody can farm them.`,
  },
  {
    href: "/social",
    kicker: "Social",
    title: "Crews, not comparisons",
    body: "Follows with approval, a feed, kudos, groups, attendance challenges and opt-in leaderboards. Your habits stay private: no board ever shows which habit, or how much.",
  },
  {
    href: "/features#anywhere",
    kicker: "Offline",
    title: "Works in a basement",
    body: "Logs save on your phone first and sync when you're back above ground. Installs to your home screen. Full export in JSON, CSV and calendar format.",
  },
];

const nots = [
  "No rewards for doing more: more hours, more weight, every single day.",
  "Nobody ever sees which habits you keep, or which you're breaking.",
  "No leaderboard for body weight, calories or volume.",
  "No streak lost to a planned rest day.",
  "No analytics, ads, trackers or third-party scripts.",
  "No lock-in. Export everything, any time.",
];
---

<Base
  title="PaceStreak — Don't break the chain"
  description="PaceStreak is a habit and streak tracker for training, learning, health and everything else worth doing regularly. Keep each habit weekly, watch the grid fill. Rest days never break it."
  path="/"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero relative isolate">

    <div
      class="wrap grid items-center gap-14 py-14 sm:py-18 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-16 lg:py-24"
    >
      <div>

        <h1
          class="text-[clamp(2.8rem,8vw,5.2rem)] leading-[0.98] font-extrabold tracking-[-0.03em] text-balance hero-title"
        >
          Don't break<br />the <span class="text-accent">chain.</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted text-pretty">
          Motivation is unreliable. Streaks aren't. PaceStreak makes consistency
          the number you chase, for anything worth doing regularly: training,
          learning a skill, sleep, reading, calm, or a habit you're breaking.
          Keep the week, watch a year fill in one square at a time.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a class="btn" href="#waitlist">Get early access</a>
          <a class="btn btn--ghost" href="/features">See the features</a>
        </div>

        <p class="mt-6 text-[0.92rem] text-dim">
          Workouts, reading, a language, water, meditation — anything you can repeat.
        </p>
      </div>

      <CalendarPage />
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="scroll-mt-24 py-20 sm:py-24">
    <div class="wrap">
      <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
        Three taps. That's the whole ritual.
      </h2>

      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          steps.map((step) => (
            <li class="card step">
              <span class="stepbox" aria-hidden="true">
                <img src="/marks/x.svg" alt="" width="40" height="40" />
              </span>
              <h3 class="mt-4 text-lg font-semibold">{step.title}</h3>
              <p class="mt-2 text-[0.96rem] leading-relaxed text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The board -->
  <section class="py-20 sm:py-24">
    <div class="wrap grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:gap-16">
      <div>
        <h2 class="max-w-xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Your whole week, on one page.
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
          The app opens on this week as a calendar: one row per habit, seven boxes, today ringed in red.
          Tap a box and a marker X draws across it. Forgot yesterday? Tap yesterday.
        </p>
        <ul class="mt-6 space-y-2.5 text-[0.98rem]">
          <li class="tick">Each kind of habit gets its own marker colour.</li>
          <li class="tick">A stroke for part-done, a ring for a slip.</li>
          <li class="tick">A note on any day, private like the habit.</li>
        </ul>
      </div>
      <WeekBoard />
    </div>
  </section>

  <!-- Features -->
  <section
    id="features"
    class="scroll-mt-24 border-y border-line bg-bg-alt py-20 sm:py-24"
  >
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <h2 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
            Built for people who show up.
          </h2>
        </div>
        <a class="btn btn--ghost" href="/features">Every feature</a>
      </div>

      <ol class="planner mt-12" aria-label="A week of PaceStreak, one feature a day">
        {
          highlights.map((item, i) => (
            <li>
              <a class="planner-row group" href={item.href}>
                <span class="planner-date" aria-hidden="true">
                  <span class="planner-wd">{["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"][i]}</span>
                  <span class="planner-n">{i + 14}</span>
                </span>
                <span class="planner-body">
                  <span class="planner-kicker">{item.kicker}</span>
                  <span class="planner-title">{item.title}</span>
                  <span class="planner-text">{item.body}</span>
                </span>
                <span class="planner-box" aria-hidden="true">
                  <img src="/marks/x.svg" alt="" width="40" height="40" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The rule -->
  <section class="py-20 sm:py-24">
    <div class="wrap grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Days off are part of it. The streak knows.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-muted text-pretty">
          A daily streak turns a day off into a failure: people train sore,
          or quit the habit the first time life gets in the way. PaceStreak
          counts weeks. With a target of four, three days off cost nothing.
        </p>
        <a class="btn mt-8" href="/streaks">Try the streak simulator</a>
      </div>

      <div class="card">
        <h3 class="text-lg font-semibold">What PaceStreak will never do</h3>
        <ul class="mt-5 space-y-3">
          {nots.map((n) => <li class="cross text-[0.96rem] text-muted">{n}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section class="border-t border-line bg-bg-alt py-20 sm:py-24">
    <div class="wrap">
      <div
        class="card flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight">
            Watch it get built, mistakes included.
          </h2>
          <p class="mt-2 max-w-xl text-[0.96rem] text-muted">
            How every part of PaceStreak was built and why: the streak engine,
            offline sync, auth, the social privacy rules, and the failures that
            only showed up in production.
          </p>
        </div>
        <a class="btn btn--ghost shrink-0" href="https://blog.pacestreak.com" rel="noopener">
          Read the blog
        </a>
      </div>
    </div>
  </section>

  <!-- Waitlist -->
  <section id="waitlist" class="scroll-mt-24 border-t border-line py-20 sm:py-24">
    <div class="wrap max-w-2xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
        Start your first streak.
      </h2>
      <p class="mt-4 text-lg text-muted text-pretty">
        PaceStreak is in early development. Follow the build, or put your name
        down and we'll email you once when it opens — nothing else.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          class="btn"
          href="mailto:hello@pacestreak.com?subject=PaceStreak%20early%20access"
        >
          Email for early access
        </a>
        <a class="btn btn--ghost" href="/faq">Read the FAQ</a>
      </div>

      <p class="mt-6 text-[0.94rem] text-muted">
        or write to <a
          class="text-accent underline-offset-4 hover:underline"
          href="mailto:hello@pacestreak.com">hello@pacestreak.com</a
        >
      </p>

      <p class="mt-3 text-[0.88rem] text-dim">
        No account, no tracking, no newsletter you didn't ask for.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-y border-line bg-bg-alt py-20 sm:py-24">
    <div class="wrap">
      <Faq items={featuredFaqs} />
      <p class="mt-8 text-center text-[0.94rem] text-muted lg:text-left">
        <a class="text-accent underline-offset-4 hover:underline" href="/faq">
          All questions
        </a>
      </p>
    </div>
  </section>

  <script is:inline type="module" src={appUrl}></script>
</Base>
