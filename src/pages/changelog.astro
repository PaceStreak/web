---
import Base from "../layouts/Base.astro";
import { releases, released } from "../data/changelog";

const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Base
  title="Changelog — PaceStreak"
  description="What's new in PaceStreak: every change a person using the app would notice, newest first."
  path="/changelog"
>
  <section class="py-16 sm:py-20">
    <div class="wrap max-w-2xl">
      <p class="eyebrow">Changelog</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight">What's new</h1>
      <p class="mt-4 text-muted">
        Every change you'd notice in the app, newest first.
        {!released && " PaceStreak isn't open to the public yet, so these are built and waiting, not live."}
      </p>

      <ol class="mt-12 space-y-14">
        {
          releases.map((r) => (
            <li>
              <p class="text-[0.92rem] text-dim">
                <time datetime={r.date}>{fmt.format(new Date(`${r.date}T00:00:00Z`))}</time>
              </p>
              <h2 class="mt-1 text-2xl font-semibold tracking-tight">{r.title}</h2>
              <ul class="mt-5 divide-y divide-line rounded-[--radius-xl2] border border-line bg-surface">
                {r.items.map((item) => (
                  <li class="flex flex-col gap-0.5 px-5 py-3.5 sm:flex-row sm:gap-4">
                    <span class="shrink-0 text-[0.88rem] font-semibold text-accent sm:w-24">{item.area}</span>
                    <span class="text-[0.95rem] text-muted">{item.text}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
