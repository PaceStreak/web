---
import Base from "../layouts/Base.astro";

// Without this page, Cloudflare Pages answers every unknown path with
// index.html and a 200. That is a soft 404: search engines index the homepage
// under dozens of wrong URLs, and a mistyped link looks like it worked.
// Astro emits this as dist/404.html, which Pages serves with a real 404 status.
---

<Base
  title="Page not found — PaceStreak"
  description="That page does not exist."
  path="/404"
  noindex
>
  <section class="py-24 sm:py-32">
    <div class="wrap max-w-xl text-center">
      <p class="eyebrow justify-center">404</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
        That page doesn't exist.
      </h1>
      <p class="mt-4 text-muted">
        The link may be out of date, or the page may never have existed.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a class="btn" href="/">Back to the site</a>
        <a class="btn btn--ghost" href="https://blog.pacestreak.com">Blog</a>
      </div>

      <nav class="mt-12" aria-label="Popular pages">
        <p class="text-[0.88rem] text-dim">Or try one of these</p>
        <ul class="mt-3 flex flex-wrap justify-center gap-x-5 gap-y-2 text-[0.94rem]">
          <li><a class="text-accent hover:underline" href="/features">Features</a></li>
          <li><a class="text-accent hover:underline" href="/streaks">Streaks</a></li>
          <li><a class="text-accent hover:underline" href="/about">About</a></li>
          <li><a class="text-accent hover:underline" href="/faq">FAQ</a></li>
          <li><a class="text-accent hover:underline" href="/privacy">Privacy</a></li>
          <li><a class="text-accent hover:underline" href="/terms">Terms</a></li>
        </ul>
      </nav>
    </div>
  </section>
</Base>
