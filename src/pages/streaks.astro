---
import Base from "../layouts/Base.astro";
import { computeChain, DEMO_GRID, STATUS_LABEL } from "../lib/chain";

const DEMO_TARGET = 3;
const chain = computeChain(DEMO_GRID, DEMO_TARGET);
const dayLetters = ["M", "T", "W", "T", "F", "S", "S"];
const dayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

const rules = [
  {
    title: "A week is kept when you hit your target",
    body: "You choose the number: three days a week, four, six. The count is distinct days trained, so two sessions on Tuesday is still one day. With a target of four, three rest days cost you nothing at all.",
  },
  {
    title: "The week in progress can't break anything",
    body: "Until Sunday night (or whichever day your week ends), the current week is open. The app tells you how many sessions you still need and how many days are left, and flags the week as at risk only when the maths says so.",
  },
  {
    title: "Freezes are earned, and spent for you",
    body: "Every four kept weeks earns a freeze, and you can hold two. When a week closes short, a freeze covers it automatically, but only if there's a streak to protect. A freeze is never wasted on a week with no run behind it.",
  },
  {
    title: "One repair a month, by hand",
    body: "Missed a week in the last fortnight that no freeze covered? You can repair one missed week per month. It restores the streak; it doesn't pay XP. A forgiven week isn't an earned one.",
  },
  {
    title: "Injured or ill? Pause it",
    body: "Declare a pause and any week it covers for four days or more is sheltered: it can't break the streak, and it doesn't add to it or pay XP. Reminders stop while it runs. A pause lasts up to twelve weeks, with 120 days a year in total, so it covers recovery without replacing training.",
  },
  {
    title: "Changing your target is fair",
    body: "Raise it for a training block, drop it during a hard month. Every past week is judged by the target that applied at the time, so you never lose history by changing plans.",
  },
  {
    title: "Nothing is stored that can drift",
    body: "There is no nightly job that closes weeks. The streak is recomputed from your logs every time it's read, so editing a session from last month corrects everything after it.",
  },
];
---

<Base
  title="How streaks work — PaceStreak"
  description="PaceStreak counts kept weeks against a target you set, not consecutive days. Rest never breaks a streak, freezes are earned automatically, and one missed week a month can be repaired."
  path="/streaks"
>
  <section class="py-16 sm:py-20">
    <div class="wrap max-w-3xl">
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        The unit is the week, not the day.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-muted text-pretty">
        A daily streak punishes the most sensible thing you can do: take a rest
        day. It pushes people to train sore, sick or injured to keep a number
        alive. PaceStreak counts <strong class="text-ink">kept weeks</strong>{" "}
        against a target you set instead, so the plan you'd follow anyway is
        exactly the plan that keeps the streak.
      </p>
    </div>
  </section>

  <section class="border-y border-line bg-bg-alt py-16 sm:py-20" aria-labelledby="sim-title">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <h2 id="sim-title" class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">
            Eight weeks. Tap a day to change it.
          </h2>
          <p class="mt-3 max-w-xl text-[0.96rem] text-muted">
            The same rules the app runs, in your browser. The bottom row is the
            current week, still open.
          </p>
        </div>

        <label class="flex items-center gap-3 text-[0.94rem]">
          <span class="text-muted">Weekly target</span>
          <select class="select" data-sim-target>
            {
              [1, 2, 3, 4, 5, 6, 7].map((n) => (
                <option value={n} selected={n === DEMO_TARGET}>
                  {n} {n === 1 ? "day" : "days"}
                </option>
              ))
            }
          </select>
        </label>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <div class="card overflow-x-auto p-4 sm:p-6" data-sim>
          <table class="sim">
            <caption class="sr-only">
              Eight weeks of training days. Each row is a week; each button is a
              day and can be toggled.
            </caption>
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Week</span></th>
                {
                  dayLetters.map((letter, d) => (
                    <th scope="col">
                      <abbr title={dayNames[d]}>{letter}</abbr>
                    </th>
                  ))
                }
                <th scope="col" class="sim__status-h">Status</th>
                <th scope="col" class="sim__run-h">Run</th>
              </tr>
            </thead>
            <tbody>
              {
                DEMO_GRID.map((week, w) => (
                  <tr>
                    <th scope="row" class="sim__week">
                      {w === DEMO_GRID.length - 1 ? "Now" : `W${w + 1}`}
                    </th>
                    {week.map((on, d) => (
                      <td>
                        <button
                          type="button"
                          class="sim__day"
                          aria-pressed={on ? "true" : "false"}
                          aria-label={`Week ${w + 1}, ${dayNames[d]}`}
                          data-w={w}
                          data-d={d}
                        />
                      </td>
                    ))}
                    <td>
                      <span class={`pill pill--${chain.weeks[w].status}`} data-status={w}>
                        {STATUS_LABEL[chain.weeks[w].status]}
                      </span>
                    </td>
                    <td class="sim__run" data-run={w}>
                      {chain.weeks[w].run}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <dl class="grid grid-cols-3 gap-4 self-start lg:grid-cols-1" aria-live="polite">
          <div class="card">
            <dt class="text-[0.78rem] tracking-[0.14em] text-dim uppercase">Current streak</dt>
            <dd class="mt-1 text-3xl font-semibold">
              <span data-out="current">{chain.current}</span>
              <span class="text-base font-normal text-dim">weeks</span>
            </dd>
          </div>
          <div class="card">
            <dt class="text-[0.78rem] tracking-[0.14em] text-dim uppercase">Longest</dt>
            <dd class="mt-1 text-3xl font-semibold" data-out="longest">{chain.longest}</dd>
          </div>
          <div class="card">
            <dt class="text-[0.78rem] tracking-[0.14em] text-dim uppercase">Freezes held</dt>
            <dd class="mt-1 text-3xl font-semibold" data-out="freezes">{chain.freezes}</dd>
          </div>
        </dl>
      </div>

      <p class="mt-6 max-w-2xl text-[0.9rem] text-dim">
        Week 5 fell short. The freeze earned by weeks 1 to 4 covered it
        automatically, so the run carried on. Take a day away from week 2 and
        watch the freeze arrive too late.
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="wrap">
      <h2 class="max-w-2xl text-3xl font-semibold tracking-tight">
        Seven rules, in the order the app applies them.
      </h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-2">
        {
          rules.map((rule, i) => (
            <li class="card">
              <span class="font-mono text-sm font-semibold text-accent">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="mt-3 text-lg font-semibold">{rule.title}</h3>
              <p class="mt-2 text-[0.96rem] leading-relaxed text-muted">{rule.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="pb-8">
    <div class="wrap max-w-3xl">
      <div class="prose-page">
        <h2>What a streak is worth</h2>
        <p>
          Kept weeks pay XP; frozen and repaired weeks keep the run alive but pay
          nothing. Milestones at 4, 8, 12, 26, 52, 104 and 156 weeks pay a fixed
          bonus. Training beyond your target plus one day in a week earns a
          quarter of the normal amount, because training every day isn't better
          than training the plan.
        </p>
        <p>
          The engineering behind all this is written up on the blog:{" "}
          <a href="https://blog.pacestreak.com/posts/streaks-count-weeks-not-days"
            >why streaks count weeks, not days</a
          >.
        </p>
      </div>
    </div>
  </section>

  <script>
    import { computeChain, STATUS_LABEL } from "../lib/chain";

    const root = document.querySelector<HTMLElement>("[data-sim]");
    const select = document.querySelector<HTMLSelectElement>("[data-sim-target]");

    if (root && select) {
      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>(".sim__day"));
      const rows = Math.max(...buttons.map((b) => Number(b.dataset.w))) + 1;

      const read = () => {
        const grid: boolean[][] = Array.from({ length: rows }, () => Array(7).fill(false));
        for (const b of buttons) {
          grid[Number(b.dataset.w)][Number(b.dataset.d)] = b.getAttribute("aria-pressed") === "true";
        }
        return grid;
      };

      const render = () => {
        const chain = computeChain(read(), Number(select.value));
        chain.weeks.forEach((week, w) => {
          const pill = root.querySelector<HTMLElement>(`[data-status="${w}"]`);
          const run = root.querySelector<HTMLElement>(`[data-run="${w}"]`);
          if (pill) {
            pill.className = `pill pill--${week.status}`;
            pill.textContent = STATUS_LABEL[week.status];
          }
          if (run) run.textContent = String(week.run);
        });
        const set = (key: string, value: number) => {
          const node = document.querySelector(`[data-out="${key}"]`);
          if (node) node.textContent = String(value);
        };
        set("current", chain.current);
        set("longest", chain.longest);
        set("freezes", chain.freezes);
      };

      root.addEventListener("click", (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".sim__day");
        if (!button) return;
        const on = button.getAttribute("aria-pressed") === "true";
        button.setAttribute("aria-pressed", on ? "false" : "true");
        render();
      });
      select.addEventListener("change", render);
    }
  </script>
</Base>
