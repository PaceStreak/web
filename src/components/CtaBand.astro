---
// The closing call to action, shared by every marketing page. One label per
// intent: "Get started free" always means sign up.
---

<section class="section" aria-labelledby="cta-title">
  <div class="wrap">
    <div class="cta-band">
      <h2 id="cta-title" class="h2">Start your first streak.</h2>
      <p class="lede">
        Create an account and the first week is already waiting for you.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn--lg" href="https://app.pacestreak.com/signup">Get started free</a>
        <a class="btn btn--ghost btn--lg" href="/features">See the features</a>
      </div>
    </div>
  </div>
</section>
