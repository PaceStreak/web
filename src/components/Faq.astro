---
import type { FaqItem } from "../data/faq";

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

{
  /* A sticky heading beside a single column of questions.

     The previous two-up grid was worse than it looked: each card sized to its
     own content so the bottoms were ragged, the reading order was ambiguous
     (across or down?), and opening one answer jumped the whole row. A single
     column makes the order obvious, and opening an answer only pushes what is
     below it. */
}
<div class="grid gap-8 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16">
  <div class="lg:sticky lg:top-24 lg:self-start">
    <p class="eyebrow">FAQ</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
      Reasonable questions.
    </h2>
    <p class="mt-4 text-[0.96rem] text-muted">
      Not covered here? Write to <a
        class="text-accent underline-offset-4 hover:underline"
        href="mailto:hello@pacestreak.com">hello@pacestreak.com</a
      > and it will get answered.
    </p>
  </div>

  <div class="divide-y divide-line rounded-[--radius-xl2] border border-line bg-surface">
    {
      items.map((item) => (
        <details class="group px-5 py-1 sm:px-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium marker:hidden">
            <span>{item.q}</span>
            <svg
              class="h-4 w-4 shrink-0 text-dim transition-transform duration-200 group-open:rotate-45"
              viewBox="0 0 16 16"
              aria-hidden="true"
            >
              <path
                d="M8 2v12M2 8h12"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              />
            </svg>
          </summary>
          <p class="pb-5 text-[0.96rem] leading-relaxed text-muted">{item.a}</p>
        </details>
      ))
    }
  </div>
</div>
