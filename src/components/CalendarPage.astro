---
/* The hero's demonstration: one page of a wall calendar, a habit crossed off
   in felt-tip marker. Synthetic example data, labelled as such below it. The
   pattern is fixed so the page renders identically on every build. */
const days = 30;
const offset = 1; // the 1st falls on a Tuesday (weeks start Monday)
const done = new Set([1, 2, 3, 5, 6, 8, 9, 10, 12, 13, 15, 16, 17, 19, 20, 22, 23, 24]);
const partial = new Set([26]);
const today = 25;
const heads = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"];
const cells = Array.from({ length: Math.ceil((days + offset) / 7) * 7 }, (_, i) => i - offset + 1);
---

<figure class="calpage" aria-label="Example: a month of reading crossed off, with a 14-week chain">
  <div class="calpage-rings" aria-hidden="true"><span></span><span></span></div>
  <header class="calpage-head">
    <span class="calpage-month">September</span>
    <span class="calpage-chain"><b>14</b> weeks unbroken</span>
  </header>
  <p class="calpage-habit">Read 20 pages · 4 days a week</p>
  <div class="calpage-grid" role="presentation">
    {heads.map((h) => <span class="calpage-wd">{h}</span>)}
    {
      cells.map((d) =>
        d < 1 || d > days ? (
          <span class="calpage-day is-blank" />
        ) : (
          <span class:list={["calpage-day", { "is-today": d === today, "is-sun": (d + offset - 1) % 7 === 6 }]}>
            <span class="calpage-num">{d}</span>
            {done.has(d) && (
              <svg viewBox="0 0 40 40" class="mark" aria-hidden="true">
                <path pathLength="1" d="M8.5 9.5c6.5 5.4 15 13.2 23 21.8" />
                <path pathLength="1" d="M31.5 8.8C24 15 16.4 22.3 8.8 31" />
              </svg>
            )}
            {partial.has(d) && (
              <svg viewBox="0 0 40 40" class="mark" aria-hidden="true">
                <path pathLength="1" d="M30.5 9.5C23.5 16 16.5 23 9.5 30.5" />
              </svg>
            )}
          </span>
        ),
      )
    }
  </div>
  <figcaption class="calpage-cap">Example month. Tap a day, it's crossed off.</figcaption>
</figure>
