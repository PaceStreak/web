---
const year = new Date().getFullYear();

const columns = [
  {
    title: "Product",
    links: [
      { href: "/features", label: "Features" },
      { href: "/streaks", label: "How streaks work" },
      { href: "/social", label: "Social" },
      { href: "/security", label: "Security" },
      { href: "/faq", label: "FAQ" },
      { href: "/#waitlist", label: "Early access" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/about", label: "About" },
      { href: "https://blog.pacestreak.com", label: "Blog" },
      { href: "https://status.pacestreak.com", label: "Status" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacy", label: "Privacy" },
      { href: "/terms", label: "Terms" },
      { href: "mailto:hello@pacestreak.com", label: "Contact" },
    ],
  },
];
---

<footer class="mt-24 border-t border-line bg-bg-alt py-14">
  <div class="wrap">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5 font-semibold">
          <svg class="h-6 w-6 text-accent" viewBox="0 0 64 64" aria-hidden="true">
            <path d="M39 5 8 39h19L25 59 56 25H37L39 5Z" fill="currentColor"></path>
          </svg>
          <span>Pace<span class="text-accent">Streak</span></span>
        </div>
        <p class="mt-3 max-w-xs text-[0.92rem] text-dim">
          Log the session, keep the streak, watch the grid fill.
        </p>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="text-[0.78rem] font-semibold tracking-[0.14em] text-dim uppercase">
              {column.title}
            </h2>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[0.94rem] text-muted transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-line pt-7 text-[0.87rem] text-dim sm:flex-row sm:items-center sm:justify-between"
    >
      <span>&copy; {year} PaceStreak</span>
      <p class="footer-links">
        <a href="https://github.com/PaceStreak" rel="noopener">GitHub</a>
        <a href="https://x.com/PaceStreak" rel="noopener">X</a>
        <a href="https://www.instagram.com/pacestreak/" rel="noopener">Instagram</a>
      </p>
    </div>
  </div>
</footer>
