---
// Every page's <head>. Centralised so a new page cannot ship without a
// canonical URL or an OG image — the kind of omission nobody notices until a
// link is shared and renders blank.
interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogImage?: string;
}

const { title, description, path, noindex = false, ogImage } = Astro.props;

const site = Astro.site ?? new URL("https://www.pacestreak.com");
const canonical = new URL(path, site).href.replace(/\/$/, "") || site.href;
const image = new URL(ogImage ?? "/brand/social/og.png", site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta name="theme-color" content="#fbfbf8" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/brand/logo-512.png" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="PaceStreak" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<link
  rel="alternate"
  type="application/rss+xml"
  title="PaceStreak Blog"
  href="https://blog.pacestreak.com/rss.xml"
/>
