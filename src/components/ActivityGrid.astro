---
// The squares themselves are generated by app.js, not written out here: 182
// hand-maintained <i> elements is not a reasonable thing to keep in markup.
// The stat numbers ARE in the markup, so they are correct with JavaScript
// disabled — app.js only animates them counting up.
---

<figure
  class="rounded-[--radius-xl2] border border-line bg-surface p-5 shadow-2xl shadow-black/40 sm:p-6"
  aria-labelledby="gridcap"
  data-grid-card
>
  <div class="flex flex-wrap items-start justify-between gap-6">
    <div>
      <p class="text-[0.78rem] font-semibold tracking-[0.14em] text-dim uppercase">
        Current streak
      </p>
      <p class="mt-1.5 flex items-baseline gap-2 text-4xl font-semibold tracking-tight">
                <span data-count="14">14</span>
        <span class="text-base font-normal text-dim">weeks</span>
      </p>
    </div>

    <dl class="flex gap-7 text-right">
      <div>
        <dt class="text-[0.78rem] tracking-wide text-dim uppercase">Longest</dt>
        <dd class="mt-1 text-xl font-semibold" data-count="22">22</dd>
      </div>
      <div>
        <dt class="text-[0.78rem] tracking-wide text-dim uppercase">Sessions</dt>
        <dd class="mt-1 text-xl font-semibold" data-count="312">312</dd>
      </div>
    </dl>
  </div>

  <div
    class="heat mt-6"
    id="heat"
    role="img"
    aria-label="Activity grid showing a 14 week training streak across the last six months, with rest days in every week"
  >
  </div>

  <div class="mt-4 flex items-center justify-end gap-1.5 text-[0.78rem] text-dim">
    <span>Less</span>
    <i class="lvl--0 block h-2.5 w-2.5 rounded-[3px]"></i>
    <i class="lvl--1 block h-2.5 w-2.5 rounded-[3px]"></i>
    <i class="lvl--2 block h-2.5 w-2.5 rounded-[3px]"></i>
    <i class="lvl--3 block h-2.5 w-2.5 rounded-[3px]"></i>
    <i class="lvl--4 block h-2.5 w-2.5 rounded-[3px]"></i>
    <span>More</span>
  </div>

  <figcaption id="gridcap" class="sr-only">
    An example activity grid: each square is a day, brighter squares are harder
    sessions. Every week of the current streak has rest days in it.
  </figcaption>
</figure>
